# Optional manual/Docker configuration. start.py generates secrets automatically.
WEBHOOK_SECRET=replace-with-a-random-32-character-or-longer-secret
DELIVERY_SECRET=use-a-different-random-32-character-or-longer-secret
ADMIN_TOKEN=use-a-third-random-32-character-or-longer-secret
DB_PATH=data/events.db
DESTINATION_URL=http://127.0.0.1:9000/webhook
RECEIVER_FAILURES=2
